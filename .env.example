# Copiar a `.env` (gitignored) y completar. Ningún valor de acá es real: ver
# requisito "Secretos fuera de las imágenes y del repositorio" en la
# capacidad `self-hosted-deployment`. El procedimiento completo de arranque
# está en `docs/despliegue.md`.

# --- Nombres públicos (dos hostnames distintos, ver cloudflared/config.example.yml) ---
APP_PUBLIC_DOMAIN=fichas.tu-dominio.com
ZITADEL_EXTERNAL_DOMAIN=auth.tu-dominio.com

# --- Base de datos de la aplicación ---
APP_DB_NAME=dnd
APP_DB_USER=dnd
APP_DB_PASSWORD=cambiar-por-una-contrasena-real

# --- Base de datos y arranque de Zitadel ---
# Fijar la versión explícitamente (no "latest"/"stable"): Zitadel v4 separa
# la UI de login en su propia imagen (`zitadel-login`) y ambas MUST usar la
# misma versión. Para actualizar: subir este valor y volver a levantar.
ZITADEL_VERSION=v4.16.2
# Contraseña del rol `zitadel`, creado junto con la base `zitadel` por
# `postgres-init/init-zitadel-db.sh` dentro de la misma instancia de
# PostgreSQL que la base de la aplicación (ver design.md, decisión D11).
ZITADEL_DB_PASSWORD=cambiar-por-otra-contrasena-real
# Exactamente 32 caracteres; generar con `openssl rand -base64 32 | head -c 32`.
ZITADEL_MASTERKEY=cambiar-por-32-caracteres-aleatorios
# Cuenta admin que Zitadel crea en el primer arranque (consola de Zitadel).
ZITADEL_ADMIN_USERNAME=admin@fichas.tu-dominio.com
ZITADEL_ADMIN_PASSWORD=cambiar-por-otra-contrasena-real
# Vencimiento del token de servicio que usa el contenedor de login para
# hablar con la API de Zitadel (no un secreto que el usuario final vea).
ZITADEL_LOGIN_CLIENT_PAT_EXPIRATION=2099-01-01T00:00:00Z

# --- Aplicación cliente OIDC ---
# Se completan DESPUÉS del primer arranque: hay que registrar la app en la
# consola de Zitadel (tarea 5.1, manual) y pegar acá lo que devuelve. La API
# no arranca sin estos dos valores (ver `ServerConfig.fromEnvironment`).
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# --- Proveedores de retratos IA (opcionales: sin valor, Pollinations sigue
#     disponible y la subida de retrato propio también, ver capacidad
#     `ai-portrait-generation`) ---
AZURE_FLUX_API_KEY=
AZURE_OPENAI_API_KEY=
